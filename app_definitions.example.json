{
  "My Application": {
    "description": "Human-readable description of what this application does",
    "rules": [
      {
        "dst_ports": ["443", "8443"],
        "applications": ["ssl"],
        "protocols": ["tcp"],
        "dst_ips": ["10.0.0.1", "10.0.1.0/24"]
      },
      {
        "src_ips": ["192.168.1.0/24"],
        "dst_ports": ["80"]
      }
